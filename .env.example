# Copy to .env for `docker compose up`.

# Kiro headless auth (Pro, Pro+, Pro Max or Power plan). Leave empty with ORRERY_COMPUTER_TARGET=computer-mock.
KIRO_API_KEY=
# computer (real kiro-cli) or computer-mock (wire-faithful mock, no account needed)
ORRERY_COMPUTER_TARGET=computer
# kiro-v3 (default), kiro-v2 or kiro-auto
ORRERY_AGENT_KIND=kiro-v3

# Console sign-in token for local development.
ORRERY_DEV_TOKEN=dev-token

# Optional: Langfuse (cloud or self-hosted)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional: provider wiring (see deploy/compose/providers.yaml)
EMBED_PROVIDER_ID=
FAST_PROVIDER_ID=
CLEF_PROVIDER_ID=
CF_ACCOUNT_ID=
CF_API_TOKEN=
