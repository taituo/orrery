# Rendered by the nginx image entrypoint (envsubst) at container start.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;

  # Runtime configuration generated from env by 40-orrery-config.sh
  location = /config.js {
    alias /tmp/orrery/config.js;
    add_header Cache-Control "no-store";
  }

  location /cli/ {
    types { text/javascript mjs; }
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Optional same-origin API proxy (docker compose / simple setups). In Kubernetes the
  # Ingress routes /v1 and /mcp to the API directly and API_UPSTREAM stays empty.
  include /etc/nginx/conf.d/api-proxy.inc*;

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
